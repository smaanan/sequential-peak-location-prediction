\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Monte Carlo interval-selection rates, empirical coverage, and mean interval widths at $T=30$, based on $M=1000$ independent replicates and the first-admissible rule \eqref  {eq:selected-candidate}. Coverage means $T_{\mathrm  {entry}}\le L\le T_{\mathrm  {exit}}$. The conditional coverage is calculated among selected intervals, and the unconditional success proportion also accounts for replicates in which no interval is selected.}}{20}{table.caption.15}\protected@file@percent }
\newlabel{tab:mc_coverage_T30}{{5}{20}{Monte Carlo interval-selection rates, empirical coverage, and mean interval widths at $T=30$, based on $M=1000$ independent replicates and the first-admissible rule \eqref {eq:selected-candidate}. Coverage means $T_{\mathrm {entry}}\le L\le T_{\mathrm {exit}}$. The conditional coverage is calculated among selected intervals, and the unconditional success proportion also accounts for replicates in which no interval is selected}{table.caption.15}{}}
