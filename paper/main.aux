\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Empirical coverage ($T_{\mathrm  {entry}}\le L\le T_{\mathrm  {exit}}$) of the selected operational intervals, using the first-admissible rule, as a function of the observation horizon $T$, based on $M=1000$ independent simulated trajectories for each combination of $\tau $ and SNR. Coverage is calculated conditionally on interval selection. The horizontal axis gives the observation horizon, and each panel corresponds to one quantile level.}}{21}{figure.caption.16}\protected@file@percent }
\newlabel{fig:mc_coverage_selected}{{5}{21}{Empirical coverage ($T_{\mathrm {entry}}\le L\le T_{\mathrm {exit}}$) of the selected operational intervals, using the first-admissible rule, as a function of the observation horizon $T$, based on $M=1000$ independent simulated trajectories for each combination of $\tau $ and SNR. Coverage is calculated conditionally on interval selection. The horizontal axis gives the observation horizon, and each panel corresponds to one quantile level}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Empirical interval-selection rate as a function of the observation horizon $T$, based on $M=1000$ independent simulated trajectories for each combination of $\tau $ and SNR. The selection rate is the proportion of replicates for which the operational rule selects an interval, and does not depend on the choice of rule within $\mathcal  K(T)$. Shaded bands are $\pm $ one Monte Carlo standard error. Each panel corresponds to one quantile level.}}{22}{figure.caption.17}\protected@file@percent }
\newlabel{fig:mc_selection_rate}{{6}{22}{Empirical interval-selection rate as a function of the observation horizon $T$, based on $M=1000$ independent simulated trajectories for each combination of $\tau $ and SNR. The selection rate is the proportion of replicates for which the operational rule selects an interval, and does not depend on the choice of rule within $\mathcal K(T)$. Shaded bands are $\pm $ one Monte Carlo standard error. Each panel corresponds to one quantile level}{figure.caption.17}{}}
