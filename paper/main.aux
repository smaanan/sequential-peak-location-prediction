\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Selection rules at $\mathrm  {SNR}=1$, $T=30$, $M=1000$, among selected intervals: coverage ($T_{\mathrm  {entry}}\le L\le T_{\mathrm  {exit}}$), mean width, and interval score ($\alpha =0.10$). ``First'' is $\min \mathcal  K(T)$, ``Narrowest'' is $\arg \min _{k\in \mathcal  K(T)} w_k(T)$.}}{17}{table.caption.11}\protected@file@percent }
\newlabel{tab:rule_comparison}{{3}{17}{Selection rules at $\mathrm {SNR}=1$, $T=30$, $M=1000$, among selected intervals: coverage ($T_{\mathrm {entry}}\le L\le T_{\mathrm {exit}}$), mean width, and interval score ($\alpha =0.10$). ``First'' is $\min \mathcal K(T)$, ``Narrowest'' is $\arg \min _{k\in \mathcal K(T)} w_k(T)$}{table.caption.11}{}}
\@writefile{toc}{\contentsline {paragraph}{Numerical results.}{18}{section*.12}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces First operationally selected candidate interval for each quantile level $\tau $ and signal-to-noise ratio. For compactness, write $T^\star = T_{\mathrm  {est}}$ and $k^\star = \setbox \z@ \hbox {\mathsurround \z@ $\textstyle k$}\mathaccent "0362{k}(T^\star )$. The interval is the first admissible candidate, $k^\star =\min \mathcal  K(T^\star )$, i.e.\ the smallest $k$ whose interval contains $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle l$}\mathaccent "0362{l}(T^\star )$. In this realization, $\mathcal  K(T^\star )$ contains a single candidate in every row, so the first-admissible and narrowest rules give the same interval. The last column reports $w_{k^\star }(T^\star ) = T_{\mathrm  {exit}}^{(k^\star )}(T^\star ) - T_{\mathrm  {entry}}^{(k^\star )}(T^\star )$.}}{18}{table.caption.13}\protected@file@percent }
\newlabel{tab:simulation_est_interval}{{4}{18}{First operationally selected candidate interval for each quantile level $\tau $ and signal-to-noise ratio. For compactness, write $T^\star = T_{\mathrm {est}}$ and $k^\star = \widehat k(T^\star )$. The interval is the first admissible candidate, $k^\star =\min \mathcal K(T^\star )$, i.e.\ the smallest $k$ whose interval contains $\widehat l(T^\star )$. In this realization, $\mathcal K(T^\star )$ contains a single candidate in every row, so the first-admissible and narrowest rules give the same interval. The last column reports $w_{k^\star }(T^\star ) = T_{\mathrm {exit}}^{(k^\star )}(T^\star ) - T_{\mathrm {entry}}^{(k^\star )}(T^\star )$}{table.caption.13}{}}
