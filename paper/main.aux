\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Empirical coverage of the selected operational intervals as a function of the observation horizon $T$, based on $M=1000$ independent simulated trajectories for each combination of $\tau $ and SNR. Coverage is calculated conditionally on interval selection. The horizontal axis gives the observation horizon, and each panel corresponds to one quantile level.}}{22}{figure.caption.17}\protected@file@percent }
\newlabel{fig:mc_coverage_selected}{{7}{22}{Empirical coverage of the selected operational intervals as a function of the observation horizon $T$, based on $M=1000$ independent simulated trajectories for each combination of $\tau $ and SNR. Coverage is calculated conditionally on interval selection. The horizontal axis gives the observation horizon, and each panel corresponds to one quantile level}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Empirical interval-selection rate as a function of the observation horizon $T$, based on $M=1000$ independent simulated trajectories for each combination of $\tau $ and SNR. The selection rate is the proportion of replicates for which the operational rule selects an interval. Each panel corresponds to one quantile level.}}{23}{figure.caption.18}\protected@file@percent }
