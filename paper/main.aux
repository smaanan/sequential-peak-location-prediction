\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Stabilization of the sequential estimator $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle l$}\mathaccent "0362{l}(T)$, based on $M = 200$ independent replications per $(\tau ,\mathrm  {SNR})$. For each signal-to-noise ratio, the table reports the median entry time at the terminal horizon, the median oscillation over $T \in [20,30]$, the median post-entry error, the proportion of replicates with $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle l$}\mathaccent "0362{l}(h) = L$, and the proportion with zero oscillation over $[20,30]$. Ranges indicate variation across the four quantile levels.}}{16}{table.caption.8}\protected@file@percent }
\newlabel{tab:stabilization}{{2}{16}{Stabilization of the sequential estimator $\widehat l(T)$, based on $M = 200$ independent replications per $(\tau ,\mathrm {SNR})$. For each signal-to-noise ratio, the table reports the median entry time at the terminal horizon, the median oscillation over $T \in [20,30]$, the median post-entry error, the proportion of replicates with $\widehat l(h) = L$, and the proportion with zero oscillation over $[20,30]$. Ranges indicate variation across the four quantile levels}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Trajectories $T \DOTSB \mapstochar \rightarrow \setbox \z@ \hbox {\mathsurround \z@ $\textstyle l$}\mathaccent "0362{l}(T)$ for $\tau = 0.50$, one panel per signal-to-noise ratio, with $M = 20$ independent replicates per panel. The red dashed line indicates the true peak location $L = 22$. At $\mathrm  {SNR} = 1000$ and $100$, the estimator stabilizes at $L$; at $\mathrm  {SNR} = 1$, it does not.}}{17}{figure.caption.9}\protected@file@percent }
\newlabel{fig:stabilization_trajectories}{{5}{17}{Trajectories $T \mapsto \widehat l(T)$ for $\tau = 0.50$, one panel per signal-to-noise ratio, with $M = 20$ independent replicates per panel. The red dashed line indicates the true peak location $L = 22$. At $\mathrm {SNR} = 1000$ and $100$, the estimator stabilizes at $L$; at $\mathrm {SNR} = 1$, it does not}{figure.caption.9}{}}
