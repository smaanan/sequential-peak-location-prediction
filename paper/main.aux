\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Empirical interval-selection rate as a function of the observation horizon $T$, based on $M=1000$ independent simulated trajectories for each combination of $\tau $ and SNR. The selection rate is the proportion of replicates for which the operational rule selects an interval, and does not depend on the choice of rule within $\mathcal  K(T)$. Shaded bands are $\pm $ one Monte Carlo standard error. Each panel corresponds to one quantile level.}}{21}{figure.caption.14}\protected@file@percent }
\newlabel{fig:mc_selection_rate}{{5}{21}{Empirical interval-selection rate as a function of the observation horizon $T$, based on $M=1000$ independent simulated trajectories for each combination of $\tau $ and SNR. The selection rate is the proportion of replicates for which the operational rule selects an interval, and does not depend on the choice of rule within $\mathcal K(T)$. Shaded bands are $\pm $ one Monte Carlo standard error. Each panel corresponds to one quantile level}{figure.caption.14}{}}
