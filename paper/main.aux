\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Estimation trajectories $T \DOTSB \mapstochar \rightarrow \hat  {l}(T)$ (left column), $\hat  {a}(T)$ (middle column), and $\hat  {s}(T)$ (right column) under asymmetric Laplace noise generated from $f_{\tau , b}(x) \propto \exp (-\rho _\tau (x / b))$, with skewness $z \in \{-0.9, -0.5, 0, 0.5, 0.9\}$ and fixed signal-to-noise ratio $\mathrm  {SNR} = 1000$. Each row corresponds to a quantile level $\tau \in \{0.25, 0.5, 0.75, 0.95\}$. Colored lines track estimates as the sample size increases from $T=4$ to $T=30$. True parameter values $(L, A, S) = (22, 1, 10)$ are shown as horizontal dashed lines for reference.}}{20}{figure.caption.10}\protected@file@percent }
