\newlabel{tab:tstar}{{1}{11}{Stabilization time $T^{*}$ for $\tau =0.50$, based on $M=200$ replicates. Median $T^{*}$ is computed over replicates with finite $T^{*}$. The last column counts $T^{*}=\infty $ as $T^{*}>L$}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Trajectories $T\DOTSB \mapstochar \rightarrow \hat  l(T)$ for $\tau =0.50$. Top: ten replicates at $\mathrm  {SNR}=1000$ and $\mathrm  {SNR}=100$. Bottom ($\mathrm  {SNR}=1$): the replicate with the smallest finite $T^{*}$ ($T^{*}=24$), whose path equals $L$ at $T=22$, leaves it at $T=23$ and returns to $L$ for $T\ge 24$, and a replicate with $T^{*}=\infty $. The dashed line is $L=22$ and black dots mark $T^{*}$.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:tstar_examples}{{3}{11}{Trajectories $T\mapsto \hat l(T)$ for $\tau =0.50$. Top: ten replicates at $\mathrm {SNR}=1000$ and $\mathrm {SNR}=100$. Bottom ($\mathrm {SNR}=1$): the replicate with the smallest finite $T^{*}$ ($T^{*}=24$), whose path equals $L$ at $T=22$, leaves it at $T=23$ and returns to $L$ for $T\ge 24$, and a replicate with $T^{*}=\infty $. The dashed line is $L=22$ and black dots mark $T^{*}$}{figure.caption.5}{}}
